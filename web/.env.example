# OpenEco Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================================================
# DATABASE
# ============================================================================

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database?schema=public
#
# Local Development:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/openeco?schema=public"
#
# Vercel + Neon:
# DATABASE_URL="postgresql://user:pass@ep-cool-darkness-123456.us-east-2.aws.neon.tech/openeco?sslmode=require"
#
# Vercel + Supabase:
# DATABASE_URL="postgresql://postgres:your-password@db.projectref.supabase.co:5432/postgres"
#
DATABASE_URL="postgresql://postgres:password@localhost:5432/openeco?schema=public"

# ============================================================================
# AUTHENTICATION (NextAuth.js)
# ============================================================================

# NextAuth Secret - REQUIRED
# Generate with: openssl rand -base64 32
# Must be at least 32 characters
NEXTAUTH_SECRET="change-this-to-a-random-32-character-or-longer-string"

# NextAuth URL - REQUIRED
# Your deployment URL
# Local: http://localhost:3000
# Vercel: https://your-project.vercel.app
# Production: https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# ============================================================================
# APPLICATION
# ============================================================================

# Public app URL (usually same as NEXTAUTH_URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# App name (optional)
NEXT_PUBLIC_APP_NAME="OpenEco"

# Node environment
NODE_ENV="development"

# Port (optional, default: 3000)
PORT=3000

# ============================================================================
# KEYCLOAK (Optional - for federated authentication)
# ============================================================================

# Keycloak issuer URL
# Example: https://keycloak.yourcompany.com/realms/openeco
# KEYCLOAK_ISSUER=""

# Keycloak client ID
# KEYCLOAK_CLIENT_ID="openeco-web"

# Keycloak client secret
# KEYCLOAK_CLIENT_SECRET=""

# ============================================================================
# DATABASE CONNECTION POOL (Optional)
# ============================================================================

# Minimum pool connections (default: 2)
# DATABASE_POOL_MIN=2

# Maximum pool connections (default: 10)
# DATABASE_POOL_MAX=10

# Connection timeout in milliseconds (default: 20000)
# DATABASE_POOL_TIMEOUT=20000

# ============================================================================
# TELEMETRY (Optional)
# ============================================================================

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# ============================================================================
# NOTES
# ============================================================================

# For local development:
# 1. Copy this file to .env.local
# 2. Update DATABASE_URL with your local PostgreSQL connection
# 3. Generate NEXTAUTH_SECRET: openssl rand -base64 32
# 4. Run: npx prisma generate && npx prisma db push
# 5. Run: npm run dev

# For Vercel deployment:
# 1. Add these variables in Vercel project settings
# 2. Use managed PostgreSQL (Neon, Supabase, Railway, etc.)
# 3. Update NEXTAUTH_URL to your Vercel URL
# 4. See VERCEL_DEPLOYMENT.md for complete guide

# Security:
# - Never commit .env.local or .env files to version control
# - Use strong random values for secrets
# - Rotate secrets regularly in production
# - Use different credentials for dev/staging/production
