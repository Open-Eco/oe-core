# OpenEco Production Environment Variables
# Copy this file to deploy/.env and fill in all values.
# NEVER commit deploy/.env to version control.

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================

# Database name
POSTGRES_DB=openeco

# Database user — use a dedicated non-superuser account
POSTGRES_USER=openeco

# Database password — generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-strong-random-password

# Host port to publish the database on (default: 5432).
# Set to an empty string to skip publishing (recommended for production).
# DB_HOST_PORT=5432

# ============================================================================
# AUTHENTICATION (NextAuth.js)
# ============================================================================

# Your public deployment URL (no trailing slash)
NEXTAUTH_URL=https://your-domain.com

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-strong-random-secret

# ============================================================================
# APPLICATION
# ============================================================================

# Display name shown in the UI
APP_NAME=OpenEco

# Docker image name and tag to deploy
IMAGE_NAME=openeco-web
IMAGE_TAG=latest

# Host port for the web application (default: 3000)
WEB_HOST_PORT=3000
